{
  "name": "claude-context",
  "displayName": "Context Push for Claude Code",
  "description": "Push @file context to Claude Code and any terminal AI agent — one shortcut, no focus steal.",
  "version": "2.0.0",
  "publisher": "lntvan166",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lntvan166/ctx-push"
  },
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "claude context",
    "anthropic",
    "context push",
    "ai",
    "ai agent",
    "terminal agent",
    "clipboard",
    "context",
    "cursor",
    "gemini",
    "copilot",
    "prompt",
    "file reference"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claude-context.addSelection",
        "title": "Add to Claude Chat (selection)"
      },
      {
        "command": "claude-context.addFile",
        "title": "Add to Claude Chat"
      },
      {
        "command": "claude-context.addFolder",
        "title": "Add to Claude Chat (folder)"
      },
      {
        "command": "claude-context.addSelectionAppend",
        "title": "Append to context buffer (selection)"
      },
      {
        "command": "claude-context.clearContext",
        "title": "Clear context buffer"
      },
      {
        "command": "claude-context.pickFromHistory",
        "title": "Pick from context history"
      },
      {
        "command": "claude-context.manageBuffer",
        "title": "Manage context buffer"
      }
    ],
    "keybindings": [
      {
        "command": "claude-context.addSelection",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus && editorLangId != 'http'",
        "win": "shift+alt+c"
      },
      {
        "command": "claude-context.addFile",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "editorTextFocus && editorLangId != 'http'",
        "win": "shift+alt+d"
      },
      {
        "command": "claude-context.addSelectionAppend",
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+alt+shift+c",
        "when": "editorTextFocus && editorLangId != 'http'",
        "win": "shift+alt+s"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "claude-context.addFile",
          "when": "!explorerResourceIsFolder",
          "group": "navigation"
        },
        {
          "command": "claude-context.addFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "claude-context.addFolder",
          "when": "false"
        },
        {
          "command": "claude-context.addSelectionAppend",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Context Push",
      "properties": {
        "claude-context.pathStyle": {
          "type": "string",
          "enum": [
            "relative",
            "absolute"
          ],
          "default": "relative",
          "description": "Whether to use paths relative to workspace root or absolute paths"
        },
        "claude-context.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show a toast notification after copying a reference to the clipboard"
        },
        "claude-context.directPush": {
          "type": "boolean",
          "default": true,
          "description": "Run the IDE bridge so Claude Code sessions connected via /ide → ctx-push receive added refs directly in their prompt (takes effect after window reload)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --external:bufferutil --external:utf-8-validate --platform=node --minify",
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --external:bufferutil --external:utf-8-validate --platform=node --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --external:bufferutil --external:utf-8-validate --platform=node --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "smoke": "node scripts/smoke-gate/gate.mjs",
    "package": "vsce package --no-dependencies",
    "package:marketplace": "vsce package --no-dependencies --baseContentUrl https://github.com/lntvan166/ctx-push/blob/main/ --baseImagesUrl https://github.com/lntvan166/ctx-push/raw/main/"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "No workspace content is executed; the extension only reads file paths and writes the clipboard."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Only file-scheme documents can be referenced; direct push requires a filesystem workspace."
    }
  }
}
